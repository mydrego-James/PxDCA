{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pxdca.local/schemas/audit-draft-v1.1.json",
  "title": "PxDCA Audit Draft",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "status",
    "source_requirement_session_id",
    "project_name",
    "audit_basis",
    "coverage",
    "findings",
    "blockers",
    "conclusion",
    "handoff",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "stage": {"const": "audit_draft"},
    "status": {"const": "draft"},
    "source_requirement_session_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "audit_basis": {"type": "array", "items": {"type": "string"}},
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "status", "evidence", "gap"],
        "properties": {
          "requirement_id": {"type": "string"},
          "status": {"enum": ["covered", "partial", "missing", "conflict", "requires_confirmation"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "gap": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "type", "severity", "description", "recommendation", "requirement_ids"],
        "properties": {
          "finding_id": {"type": "string"},
          "type": {"enum": ["coverage", "conflict", "assumption", "scope", "traceability", "other"]},
          "severity": {"enum": ["blocker", "major", "minor", "observation"]},
          "description": {"type": "string"},
          "recommendation": {"type": "string"},
          "requirement_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "conclusion": {"enum": ["draft_pending_review", "draft_blocked", "draft_ready_for_review"]},
    "handoff": {
      "type": "object",
      "required": ["disposition", "recommended_owner", "next_purpose", "required_actions", "evidence_refs", "unresolved_risks"],
      "properties": {
        "disposition": {"enum": ["ready_for_handoff", "revise_pm", "revise_pg", "user_decision_required", "hold"]},
        "recommended_owner": {"enum": ["requester", "pm", "pg", "executor", "external"]},
        "next_purpose": {"type": "string", "minLength": 1},
        "required_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unresolved_risks": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
