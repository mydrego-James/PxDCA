{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logicmcp.local/schemas/software-specification-v1.json",
  "title": "LogicMCP Software Specification Payload",
  "type": "object",
  "required": ["profile", "project", "scope", "requirements", "technical", "assumptions", "unresolved_decisions"],
  "properties": {
    "profile": {"enum": ["simple", "professional", "consultant"]},
    "project": {
      "type": "object",
      "required": ["name", "purpose", "version", "status", "date"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "status": {"type": "string"},
        "date": {"type": "string"},
        "stakeholders": {"type": "array", "items": {"type": "string"}},
        "success_metrics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {
      "type": "object",
      "required": ["in", "out"],
      "properties": {
        "in": {"type": "array", "items": {"type": "string"}},
        "out": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "priority", "acceptance"],
        "properties": {
          "id": {"pattern": "^REQ-[0-9]{3}$"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "priority": {"enum": ["Must", "Should", "Could"]},
          "source": {"type": "string"},
          "business_rules": {"type": "array", "items": {"type": "string"}},
          "exceptions": {"type": "array", "items": {"type": "string"}},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "non_functional_requirements": {"type": "array", "items": {"type": "object"}},
    "technical": {
      "type": "object",
      "required": ["choices", "architecture", "implementation_items"],
      "properties": {
        "choices": {"type": "array", "items": {"type": "object"}},
        "architecture": {"type": "string"},
        "implementation_items": {"type": "array", "items": {"type": "object"}},
        "interfaces": {"type": "array", "items": {"type": "object"}},
        "data_dictionary": {"type": "array", "items": {"type": "object"}},
        "security": {"type": "array", "items": {"type": "string"}},
        "deployment": {"type": "array", "items": {"type": "string"}},
        "test_strategy": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_decisions": {"type": "array", "items": {"type": "object"}},
    "consulting": {"type": "object"}
  }
}
