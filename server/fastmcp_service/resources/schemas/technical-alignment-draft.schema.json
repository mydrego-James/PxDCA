{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pxdca.local/schemas/technical-alignment-draft-v1.json",
  "title": "PxDCA Technical Alignment Draft",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "status",
    "source_requirement_session_id",
    "project",
    "requirement_alignment",
    "architecture_outline",
    "technical_choices",
    "assumptions",
    "unresolved_decisions",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"const": "technical_alignment_draft"},
    "status": {"const": "draft"},
    "source_requirement_session_id": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "required": ["name", "purpose"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "requirement_alignment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "summary", "technical_implications", "architecture_acceptance_criteria", "coverage_status"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "summary": {"type": "string"},
          "technical_implications": {"type": "array", "items": {"type": "string"}},
          "architecture_acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "coverage_status": {"enum": ["covered", "partial", "unresolved"]},
          "notes": {"type": "string"}
        }
      }
    },
    "architecture_outline": {"type": "array", "items": {"type": "string"}},
    "technical_choices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "proposal", "rationale", "requirement_ids"],
        "properties": {
          "area": {"type": "string"},
          "proposal": {"type": "string"},
          "rationale": {"type": "string"},
          "confidence": {"enum": ["low", "medium", "high"]},
          "requirement_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "blocking"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
