{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://specialist-turn",
  "title": "Scoped Specialist Turn",
  "type": "object",
  "required": ["schema_version", "stage", "assigned_boundary_id", "expert_profile", "assigned_assessment", "cross_domain_evidence", "question", "reason"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"const": "specialist_turn"},
    "assigned_boundary_id": {"type": "string", "pattern": "^B[0-9]{2,}$"},
    "expert_profile": {"type": "string", "minLength": 1},
    "assigned_assessment": {
      "type": "object",
      "required": ["status", "normalized_value", "evidence", "reason"],
      "properties": {
        "status": {"enum": ["sufficient", "needs_clarification", "default_recommended", "conflict"]},
        "normalized_value": {},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "cross_domain_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "evidence", "status"],
        "properties": {
          "possible_boundary_id": {"type": ["string", "null"]},
          "dimension": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1},
          "status": {"const": "pending_consultant_review"}
        },
        "additionalProperties": false
      }
    },
    "question": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["boundary_id", "target_fact", "type", "text", "options"],
          "properties": {
            "boundary_id": {"type": "string"},
            "target_fact": {"type": "string"},
            "type": {"enum": ["single_choice", "multi_choice", "yes_no", "fill_in"]},
            "text": {"type": "string", "minLength": 1},
            "options": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "reason": {"type": "string"}
  },
  "additionalProperties": false
}
