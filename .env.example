# PxDCA local runtime. Non-secret defaults live in config/pxdca.toml.
PXDCA_CONFIG=./config/pxdca.toml

# Optional environment overrides
# PXDCA_HOST=127.0.0.1
# PXDCA_PORT=8000
# PXDCA_PATH=/mcp
# PXDCA_TRANSPORT=http
# PXDCA_STATE_ROOT=./data/state
# PXDCA_ARTIFACT_ROOT=./data/artifacts
# PXDCA_ARTIFACTS_ENABLED=true
# PXDCA_ALLOW_TOOL_OUTPUT_OVERRIDE=false
# PXDCA_LOG_ROOT=./data/logs
# PXDCA_LOG_LEVEL=INFO

# Docker Compose host settings
PXDCA_BIND_HOST=127.0.0.1
PXDCA_HOST_PORT=8000
PXDCA_CONFIG_FILE=./config/pxdca.toml
